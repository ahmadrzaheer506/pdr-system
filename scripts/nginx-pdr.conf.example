# Nginx reverse proxy for the CRM (Node listens on 127.0.0.1:4000).
# Copy to /etc/nginx/sites-available/pdr-system and replace YOUR_DOMAIN.
#
#   sudo cp scripts/nginx-pdr.conf.example /etc/nginx/sites-available/pdr-system
#   sudo nano /etc/nginx/sites-available/pdr-system
#   sudo ln -sfn /etc/nginx/sites-available/pdr-system /etc/nginx/sites-enabled/pdr-system
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d YOUR_DOMAIN

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}

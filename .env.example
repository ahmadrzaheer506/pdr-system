# ============================================================
# Paul Douglas Roofing — Business OS
# Copy to .env and fill in as keys become available.
# EVERY integration works in "simulated mode" until its keys
# are added — the app never blocks on a missing key.
# ============================================================

# ---------- Core (required to run) ----------
PORT=4000
# Public URL of the app (webhooks, OAuth, PDF links, cookies). Local: this value.
# Production behind nginx: http://<droplet-ip> or https://your.domain — no :4000.
APP_URL=http://localhost:4000
# Long random string — sign-in tokens. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# PostgreSQL connection (local Postgres for development; Compose overrides this for the app service)
DATABASE_URL=postgres://pdr:pdr@localhost:5432/roofing_crm
# DigitalOcean Managed Postgres — add ?sslmode=require (or set DATABASE_SSL=true)
# DATABASE_SSL=true
# DATABASE_SSL_CA=/path/to/ca-certificate.crt
# Generated PDFs and clock-out photos (not the database)
DATA_DIR=./data

# Job addresses are geocoded for distance-from-site flags (requirement 9.2) via Photon, then Nominatim.
# No API key. Clock-in is never blocked if the lookup fails.

# ---------- AI (scheduling assistant + follow-up drafting) ----------
# Provide EITHER key. Without one, the built-in rule-based scheduler is used (still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# auto | anthropic | openai
AI_PROVIDER=auto

# ---------- WhatsApp Business (Meta Cloud API) ----------
# Powers: customer WhatsApp inbox, quote sending, automatic follow-ups
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved template names (created in Meta Business Manager)
WHATSAPP_TEMPLATE_QUOTE=quote_sent
WHATSAPP_TEMPLATE_FOLLOWUP=quote_followup

# ---------- Facebook Page (Messenger + Lead Ads) ----------
# Powers: FB messages & lead-form submissions -> CRM inbox
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---------- Meta webhook security (shared by WhatsApp + Facebook) ----------
# YOU invent META_VERIFY_TOKEN (any random string) and enter the same value in the Meta console
META_VERIFY_TOKEN=pdr-verify-2026
META_APP_SECRET=

# ---------- Outbound email (Mailgun) ----------
# Powers: emailed quotes, email follow-ups, notifications
# Private API key from Mailgun → Settings → API keys. Domain must be verified (SPF/DKIM).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Paul Douglas Roofing <office@pauldouglasroofing.co.uk>"
# us (default) or eu
MAILGUN_REGION=us

# ---------- Inbound email ----------
# Secret token for the inbound-parse webhook URL (Mailgun Routes)
# Webhook: POST {APP_URL}/api/webhooks/email?secret={EMAIL_INBOUND_SECRET}
EMAIL_INBOUND_SECRET=change-me

# ---------- Google Calendar (OAuth2) ----------
# Powers: site visits booked from CRM -> Paul's calendar, two-way sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console:
# {APP_URL}/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# ---------- QuickBooks Online (UK) ----------
# Powers: one-click invoice push, payment status sync back
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must match the redirect URI registered at developer.intuit.com:
# {APP_URL}/api/integrations/quickbooks/callback
QBO_REDIRECT_URI=
# sandbox | production
QBO_ENVIRONMENT=sandbox

# ---------- Telephony (optional — call/SMS capture into lead inbox) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
